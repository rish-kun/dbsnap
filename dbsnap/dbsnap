#!/bin/bash
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

if command -v bun >/dev/null 2>&1; then
    BUN_BIN="$(command -v bun)"
elif [ -x "$HOME/.bun/bin/bun" ]; then
    BUN_BIN="$HOME/.bun/bin/bun"
else
    echo "Error: bun is not installed or not available in PATH."
    echo "Install Bun from https://bun.sh or add it to PATH."
    exit 1
fi

# This wrapper is the CLI entrypoint. It executes the source CLI directly,
# so fixes in src/index.tsx apply to `./dbsnap` without a separate build step.
exec "$BUN_BIN" run "$DIR/src/index.tsx" "$@"
